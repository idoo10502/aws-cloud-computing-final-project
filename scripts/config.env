# ===== scripts/config.env =====
export AWS_REGION=eu-central-1
export AWS_PAGER=""                      # no "less" popping up on every command
export PROJECT=final-project
export VPC_CIDR=10.0.0.0/16
export PUB_A_CIDR=10.0.1.0/24  PUB_B_CIDR=10.0.2.0/24
export PRIV_A_CIDR=10.0.11.0/24 PRIV_B_CIDR=10.0.12.0/24
export AZ_A=${AWS_REGION}a AZ_B=${AWS_REGION}b
export ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

STATE_FILE="$(dirname "${BASH_SOURCE[0]}")/state.env"
[ -f "$STATE_FILE" ] && source "$STATE_FILE"
save() { echo "export $1=$2" >> "$STATE_FILE"; export "$1=$2"; }